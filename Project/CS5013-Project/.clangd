CompileFlags:
  Add:
    - -stdlib=libstdc++
    - -x
    - cuda
    - -std=c++20
    - --cuda-path=/usr/local/cuda-12.8
    - --cuda-gpu-arch=sm_86
    - -I/usr/local/cuda-12.8/include
    - -I/usr/local/cuda-12.8/targets/x86_64-linux/include
    - -I/usr/include/c++/12
    - -I/usr/include/x86_64-linux-gnu/c++/12
    - -Iinclude
    - -Isrc

  Remove:
    - -forward-unknown-to-host-compiler
    - -rdc=true
    - --generate-code=arch=compute_60,code=[compute_60,sm_60]
    - --generate-code=arch=compute_75,code=[compute_75,sm_75]
    - --generate-code=arch=compute_80,code=[compute_80,sm_80]
    - --generate-code=arch=compute_86,code=[compute_86,sm_86]
    - --generate-code=arch=compute_89,code=[compute_89,sm_89]
    - --generate-code=arch=compute_90,code=[compute_90,sm_90]
    - --generate-code=arch=compute_120,code=[compute_120,sm_120]
    - -Xcompiler=-fPIE
    - -Xcudafe
    - --diag_suppress=550
    - -G
